{
  "name": "@journey-to-code/open-string-case",
  "version": "1.0.0",
  "description": "Dependency-free string case conversion between camel, Pascal, kebab, snake, and title case.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "string",
    "case",
    "camelcase",
    "pascalcase",
    "kebab-case",
    "snake-case"
  ],
  "license": "MIT",
  "sideEffects": false
}
